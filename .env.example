NODE_ENV=production
LOG_LEVEL=info

DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
DISCORD_CLIENT_ID=123456789012345678
PREFIX=?

# -----------------------------------------------------------------------------
# DISCORD (Serveurs, Rôles, Salons)
# -----------------------------------------------------------------------------
# Ces identifiants ne sont pas des secrets : ils sont configurés en clair dans
# src/config/discordConfig.js, pas ici. Modifiez ce fichier pour renseigner ou
# mettre à jour un serveur, un rôle ou un salon.

# -----------------------------------------------------------------------------
# CONFIGURATION HTTP & ATLAS
# -----------------------------------------------------------------------------
INTERNAL_BOT_API_KEY=YOUR_SECURE_RANDOM_INTERNAL_API_KEY_HERE
HTTP_PORT=4000
HTTP_HOST=127.0.0.1

ATLAS_BASE_URL=https://hyori-rp.fr
ATLAS_PLAYER_SPACE_URL=https://hyori-rp.fr/espace-joueur

DATA_DIR=./data
